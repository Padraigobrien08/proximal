# mock = fixture-only offline demo (no credentials). live = Claude via the Anthropic API.
LLM_MODE=mock
# Live mode requires BOTH of these. Never expose them through NEXT_PUBLIC_ variables.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Local data directory (SQLite database + uploaded PDFs). Gitignored.
PROXIMAL_DATA_DIR=./data
# Display timezone. Scheduling always uses elapsed UTC milliseconds.
PROXIMAL_TIMEZONE=Europe/London
