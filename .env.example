# mock = offline fixture demo (no credentials)
# openai = live grading/tutoring/curriculum via the OpenAI API
# anthropic = live via the Anthropic API ("live" is accepted as an alias)
LLM_MODE=mock

# LLM_MODE=openai requires a key and a model for every job. No model is chosen for you.
# OPENAI_MODEL is the default; per-job overrides take precedence.
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_MODEL_ASSESS=        # grading answers against rubrics (accuracy matters most)
# OPENAI_MODEL_CURRICULUM=    # drafting topics from a PDF (runs once per import)
# OPENAI_MODEL_TUTOR=         # gap explanations (interactive; favour speed)
# Optional reasoning effort per job, only sent when set: none|minimal|low|medium|high|xhigh|max
# OPENAI_EFFORT_ASSESS=
# OPENAI_EFFORT_CURRICULUM=
# OPENAI_EFFORT_TUTOR=

# LLM_MODE=anthropic: same pattern (ANTHROPIC_MODEL default + optional per-job overrides).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# ANTHROPIC_MODEL_ASSESS=
# ANTHROPIC_MODEL_CURRICULUM=
# ANTHROPIC_MODEL_TUTOR=
# Optional effort per job: low|medium|high|xhigh|max
# ANTHROPIC_EFFORT_ASSESS=
# ANTHROPIC_EFFORT_CURRICULUM=
# ANTHROPIC_EFFORT_TUTOR=

# Never expose keys through NEXT_PUBLIC_ variables; they are only read on the server.
# Local data directory (SQLite database + uploaded PDFs). Gitignored.
PROXIMAL_DATA_DIR=./data
# Display timezone. Scheduling always uses elapsed UTC milliseconds.
PROXIMAL_TIMEZONE=Europe/London
