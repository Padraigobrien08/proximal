{
  "name": "proximal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "demo:reset": "tsx --conditions=react-server scripts/demo-reset.ts",
    "eval:fixtures": "tsx --conditions=react-server scripts/eval-fixtures.ts",
    "content:review": "tsx --conditions=react-server scripts/content-review.ts",
    "questions:import": "tsx --conditions=react-server scripts/import-questions.ts",
    "data:export": "tsx --conditions=react-server scripts/export-course.ts",
    "data:delete-course": "tsx --conditions=react-server scripts/delete-course.ts",
    "db:backup": "tsx --conditions=react-server scripts/backup.ts",
    "usage": "tsx --conditions=react-server scripts/usage.ts",
    "smoke:live": "tsx --conditions=react-server scripts/smoke-live.ts",
    "doctor": "tsx --conditions=react-server scripts/doctor.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "better-sqlite3": "13.0.3",
    "katex": "0.19.0",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "openai": "7.23.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/katex": "0.16.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "pdf-lib": "1.17.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
